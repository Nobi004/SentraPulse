# SentraPulse — copy to .env to override. Every key has a working default,
# so `docker compose up` runs with zero setup.
# Compose reads the root .env automatically (optional file); the only keys
# it honours are LLM_PROVIDER, GEMINI_API_KEY, INGEST_API_KEY,
# SIMULATOR_ENABLED — the rest below are for local `backend/.env` dev.
# The backend reads these via backend/src/config/env.ts (Zod-parsed).

NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/api-monitor
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Anomaly thresholds (ms)
HIGH_RESPONSE_TIME_MS=5000
VERY_HIGH_RESPONSE_TIME_MS=10000
MAX_BATCH_SIZE=100
OBSERVATION_TTL_DAYS=30

# AI: none = template fallback only (default, no key needed).
# Set LLM_PROVIDER=gemini plus GEMINI_API_KEY to enable AI explanations.
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=5000
LLM_CONCURRENCY=5
LLM_MAX_PER_REQUEST=10

# Optional shared secret for POST /monitor (header x-api-key).
# Empty = open (default).
INGEST_API_KEY=

# Built-in traffic simulator (calls the service directly, no HTTP).
# Default false (safe); docker-compose sets true for the demo stack.
SIMULATOR_ENABLED=false
SIMULATOR_INTERVAL_MS=15000
