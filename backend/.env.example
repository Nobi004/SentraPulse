# Local dev copy-to-.env — same keys as the root .env.example.
# `docker compose up` needs no file at all (defaults are baked in).
PORT=4000
MONGODB_URI=mongodb://localhost:27017/api-monitor
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

HIGH_RESPONSE_TIME_MS=5000
VERY_HIGH_RESPONSE_TIME_MS=10000
MAX_BATCH_SIZE=100
OBSERVATION_TTL_DAYS=30

# none = template fallback only (default, no key needed).
# Set LLM_PROVIDER=gemini plus GEMINI_API_KEY for AI explanations.
LLM_PROVIDER=none
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_TIMEOUT_MS=5000
LLM_CONCURRENCY=5
LLM_MAX_PER_REQUEST=10

# Optional shared secret for POST /monitor (header x-api-key). Empty = open.
INGEST_API_KEY=

SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL_MS=15000
